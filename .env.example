# Copie para .env e preencha. Nunca versione o .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-isto
POSTGRES_DB=lastro
# Porta do banco na máquina. Troque se já houver um Postgres usando a 5432 (ex.: 55432).
DB_PORTA_HOST=5432
APP_DB_PASSWORD=troque-isto-app
INGEST_DB_PASSWORD=troque-isto-ingest

JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_EXP_MINUTES=480
CORS_ORIGIN=http://localhost:5173
DEMO_MODE=true
# Frontend: respostas simuladas em POST /consultas enquanto a T11 não existe (a tela avisa). false na demo.
CONSULTAS_SIMULADAS=false

# LLM: gemini | mock (mock = sem rede, determinístico; a demo precisa funcionar com ele)
LLM_PROVIDER=mock
LLM_MODEL=
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=20

# Fontes
PNCP_BASE_URL=https://pncp.gov.br/api/consulta
# PE vem do TCE-PE (sem sobreposição). Só ligue o fallback se o pe_portal falhar.
PNCP_UFS=AL
PNCP_PE_FALLBACK=false
# O PNCP não filtra por UF: o conector lê o país inteiro (cerca de 175 mil contratos por mês, ~6 min por mês a 1 req/s).
# Para a demo, um mês basta. Período longo leva horas.
PNCP_DATA_INICIAL=20261001
PNCP_DATA_FINAL=20261031
# TCE-PE: API de dados abertos (só responde a IP brasileiro). Confirmar caminhos dos endpoints na documentação.
TCEPE_BASE_URL=https://sistemas.tcepe.tc.br/DadosAbertos
TCEPE_ANOS=2025,2026
TCEPE_ESFERAS=E,M
TCEPE_MUNICIPIOS=
PORTAL_TRANSPARENCIA_API_KEY=
# CEIS/CNEP: arquivo diário; dia sem arquivo responde 403, então volta até N dias e depois usa data/raw/sancoes/
SANCOES_DIAS_RETROATIVOS=7
QSA_BASE_URL=https://minhareceita.org
REQUESTS_PER_SECOND=1
